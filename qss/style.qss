/* ==== Графитовая тема ==== */

QPushButton.bla {
    background-color: #45484e;
    color: #e8eaed;
    border: 2px solid #5e636a;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: bold;
    font-size: 12px;
}
QPushButton.bla:hover {
    background-color: #52565d;
    border-color: #70757c;
}
QPushButton.bla:pressed {
    background-color: #3b3e44;
    border-color: #50555c;
}
QPushButton.bla:disabled {
    background-color: #3e4147;
    color: #8a9097;
    border-color: #4d5158;
}

QPushButton.active {
    background-color: #b45309;
    border: 2px solid #d97706;
    border-radius: 6px;
    padding: 8px 14px;
    color: #ffffff;
    font-weight: bold;
    font-size: 12px;
}
QPushButton.active:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c2620f, stop:1 #b45309);
    border: 2px solid #e88a1a;
}
QPushButton.active:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #96450a, stop:1 #8a3f08);
    border: 2px solid #a8570c;
}

QToolBar {
    background-color: #2f3237;
    border: none;
    border-bottom: 1px solid #50555c;
    padding: 4px 8px;
    spacing: 4px;
}

QLabel.toolbar-section {
    color: #aab0b6;
    font-size: 11px;
    font-weight: bold;
    padding: 0;
}

QLabel.panel-section {
    color: #aab0b6;
    font-size: 11px;
    font-weight: bold;
    padding: 4px 2px 2px 2px;
}

QDockWidget {
    color: #e8eaed;
}
QDockWidget::title {
    background-color: #2f3237;
    padding: 8px;
    border-bottom: 1px solid #50555c;
    font-weight: bold;
    font-size: 12px;
}
QDockWidget > QWidget {
    background-color: #34383e;
}

QListWidget {
    background-color: #292c31;
    alternate-background-color: #2f3237;
    color: #e8eaed;
    border: 1px solid #50555c;
    border-radius: 4px;
    outline: none;
    padding: 2px;
}
QListWidget::item {
    padding: 5px 6px;
    border-radius: 3px;
}
QListWidget::item:hover {
    background-color: #34373d;
}
QListWidget::item:selected {
    background-color: #474b51;
    color: #ffffff;
    border-left: 2px solid #f5a623;
}

QStatusBar {
    background-color: #2f3237;
    color: #c8ccd1;
    border-top: 1px solid #50555c;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #c8ccd1;
}

QToolTip {
    background-color: #23262a;
    color: #e8eaed;
    border: 1px solid #5e636a;
    border-radius: 4px;
    padding: 6px;
    font-size: 12px;
}

/* ==== Диалоги (уведомления и ввод значений) ==== */

QMessageBox, QInputDialog {
    background-color: #34383e;
}
QMessageBox QLabel, QInputDialog QLabel {
    color: #e8eaed;
    font-size: 12px;
}
QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: #45484e;
    color: #e8eaed;
    border: 2px solid #5e636a;
    border-radius: 6px;
    padding: 6px 18px;
    font-weight: bold;
    font-size: 12px;
    min-width: 80px;
}
QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: #52565d;
    border-color: #70757c;
}
QMessageBox QPushButton:pressed, QInputDialog QPushButton:pressed {
    background-color: #3b3e44;
    border-color: #50555c;
}
QMessageBox QPushButton:default, QInputDialog QPushButton:default {
    border-color: #b45309;
}

QInputDialog QLineEdit, QInputDialog QSpinBox {
    background-color: #292c31;
    color: #e8eaed;
    border: 1px solid #5e636a;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #b45309;
}
QInputDialog QSpinBox {
    padding-right: 20px;
}
QInputDialog QSpinBox::up-button, QInputDialog QSpinBox::down-button {
    subcontrol-origin: border;
    background-color: #45484e;
    border-left: 1px solid #5e636a;
    width: 18px;
}
QInputDialog QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}
QInputDialog QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}
QInputDialog QSpinBox::up-button:hover, QInputDialog QSpinBox::down-button:hover {
    background-color: #52565d;
}
QInputDialog QSpinBox::up-arrow {
    image: url(icons/arrow-up.svg);
    width: 8px;
    height: 8px;
}
QInputDialog QSpinBox::down-arrow {
    image: url(icons/arrow-down.svg);
    width: 8px;
    height: 8px;
}

/* ==== Скроллбары ==== */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background-color: #5e636a;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #70757c;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background-color: #5e636a;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #70757c;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
