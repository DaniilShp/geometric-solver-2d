QPushButton.bla {
    background-color: #34495e;
    color: #ecf0f1;
    border: 2px solid #46627f;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 10px;
}
QPushButton.bla:hover {
    background-color: #3f5a73;
    border-color: #557996;
}
QPushButton.bla:pressed {
    background-color: #2c3e50;
    border-color: #3d5566;
}
QPushButton.bla:disabled {
    background-color: #2e4457;
    color: #7f8c8d;
    border-color: #3d5566;
}

